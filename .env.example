# Primary transactional store
DATABASE_URL=postgresql+psycopg://fulfillos:fulfillos@localhost:5432/fulfillos

# API
FULFILLOS_ENV=development
FULFILLOS_JWT_SECRET=change-me-in-production
FULFILLOS_ACCESS_TOKEN_MINUTES=30
FULFILLOS_REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000

# Optional event/cache infrastructure
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# Optional secondary telemetry/read-model store. Leave blank unless enabled.
MONGODB_URI=
MONGODB_DATABASE=fulfillos_telemetry

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

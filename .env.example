# Primary transactional store
DATABASE_URL=postgresql+psycopg://fulfillos:fulfillos@localhost:5432/fulfillos

# PDA session lifetime
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Optional cache/event infrastructure
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# Optional secondary telemetry/read-model store (not authoritative inventory)
MONGODB_URI=
MONGODB_DATABASE=fulfillos_telemetry

# Web control tower
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

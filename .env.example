# Primary transactional store (Neon/Vercel can inject postgresql://; backend normalizes to psycopg v3)
DATABASE_URL=postgresql+psycopg://fulfillos:fulfillos@localhost:5432/fulfillos

# PDA session lifetime
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Production bootstrap users. Never commit real passwords.
BOOTSTRAP_PICKER_USERNAME=picker
BOOTSTRAP_PICKER_PASSWORD=
BOOTSTRAP_SUPERVISOR_USERNAME=supervisor
BOOTSTRAP_SUPERVISOR_PASSWORD=
DEMO_SEED=0

# Optional cache/event infrastructure
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# MongoDB Atlas telemetry/read-model store (not authoritative inventory)
MONGODB_URI=
MONGODB_DATABASE=fulfillos_telemetry

# Web control tower local override. Leave unset on Vercel Services.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
